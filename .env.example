# Copiá este archivo como `.env.local` (dev) y completá los valores reales.
# En Vercel cargá las mismas variables desde Project Settings → Environment Variables.

# ---------- Base de datos (Postgres) ----------
# Producción: Vercel Postgres / Neon / Supabase. Formato:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Dev local: podés crear una rama gratis en https://neon.tech (o correr Postgres
# local). NO uses SQLite — Vercel tiene filesystem efímero y se pierden los datos.
DATABASE_URL="postgresql://user:password@host:5432/finanzas?sslmode=require"

# Algunos providers (Neon, Supabase) ofrecen una segunda URL "directa" que se
# usa solo para migraciones (`prisma migrate`). Si tu provider no la pide,
# dejala igual a DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/finanzas?sslmode=require"

# ---------- APIs externas (opcionales) ----------

# CoinMarketCap — precios de cripto. Si la dejás vacía, el código cae a
# CoinGecko (gratis, sin key). Recomendada para el plan Basic free de CMC.
# https://pro.coinmarketcap.com/account
COINMARKETCAP_API_KEY=""

# Anthropic — habilita el asistente IA con tool use (chat + análisis de imágenes).
# https://console.anthropic.com/settings/keys
# Usamos un nombre propio (FINANZAS_AI_KEY) porque algunos shells/runtimes setean
# ANTHROPIC_API_KEY="" automáticamente y eso pisa lo que pongas acá.
FINANZAS_AI_KEY=""
